# Absolute path to the separately provisioned private Vault data directory.
PERSONAL_VAULT_ROOT=/Users/your-user/personal-vault

# Local MCP listener.
MCP_PORT=8787

# Optional public endpoint used only for OAuth metadata.
MCP_PUBLIC_BASE_URL=
MCP_GOOGLE_AUTH=true
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAINS=

# Temporary adapter while the Assistant owns the dashboard-specific structured processors.
DASHBOARD_BASE_URL=http://127.0.0.1:3002
CAPTURE_REVIEW_PROVIDER=codex
CAPTURE_REVIEW_TIMEOUT_MS=20000
