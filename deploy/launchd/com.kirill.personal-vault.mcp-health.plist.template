<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kirill.personal-vault.mcp-health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec __REPO_DIR__/deploy/check-vault-health.sh</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__VAULT_ROOT__/logs/personal-vault-mcp-health.out.log</string>
  <key>StandardErrorPath</key><string>__VAULT_ROOT__/logs/personal-vault-mcp-health.err.log</string>
</dict>
</plist>
