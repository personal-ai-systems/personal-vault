<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kirill.personal-vault.google-drive-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec __REPO_DIR__/deploy/backup-personal-vault-to-google-drive.sh</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__VAULT_ROOT__/logs/google-drive-backup.out.log</string>
  <key>StandardErrorPath</key><string>__VAULT_ROOT__/logs/google-drive-backup.err.log</string>
</dict>
</plist>
