{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-systems.github.io/personal-vault/contracts/v1/personal-vault.schema.json",
  "title": "Personal Vault Contract v1",
  "description": "Schema definitions for neutral Personal Vault records, assets, provenance, audit events, search, change feeds and approved mutations. This schema does not define domain meaning.",
  "$defs": {
    "contractVersion": {
      "const": "personal-vault/v1"
    },
    "recordId": {
      "type": "string",
      "pattern": "^pvr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "assetId": {
      "type": "string",
      "pattern": "^pva_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "mutationId": {
      "type": "string",
      "pattern": "^pvm_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^pve_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "opaqueCursor": {
      "type": "string",
      "pattern": "^v1:[A-Za-z0-9_-]{1,512}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["user", "application", "service", "migration", "recovery"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "privacy": {
      "enum": ["private", "restricted", "shared", "public"]
    },
    "metadata": {
      "type": "object",
      "description": "Namespaced, consumer-defined metadata. Personal Vault validates the namespace shape and privacy policy but not domain meaning.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}(?:\\.[a-z][a-z0-9-]{0,63})+$"
      },
      "additionalProperties": true
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "text", "hash"],
      "properties": {
        "format": {
          "enum": ["markdown", "plain-text"]
        },
        "text": {
          "type": "string"
        },
        "hash": {
          "$ref": "#/$defs/sha256"
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{2,8})*$"
        }
      }
    },
    "assetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "role"],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/assetId"
        },
        "role": {
          "enum": ["attachment", "preview", "source", "derived"]
        },
        "caption": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "assetReferenceDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": {
          "enum": ["attachment", "preview", "source", "derived"]
        },
        "caption": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "capturedAt", "capturedBy"],
      "properties": {
        "origin": {
          "enum": ["direct", "import", "derivation", "migration", "recovery"]
        },
        "capturedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "capturedBy": {
          "$ref": "#/$defs/actor"
        },
        "sourceLocator": {
          "type": "string",
          "maxLength": 4096
        },
        "sourceRecordIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/recordId"
          }
        },
        "processor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}(?:\\.[a-z][a-z0-9-]{0,63})+$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "configurationHash": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "sourceHash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "derivation"
              }
            },
            "required": ["origin"]
          },
          "then": {
            "properties": {
              "sourceRecordIds": {},
              "processor": {}
            },
            "required": ["sourceRecordIds", "processor"]
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "recordId",
        "revision",
        "state",
        "createdAt",
        "updatedAt",
        "createdBy",
        "privacy",
        "content",
        "provenance",
        "assetRefs",
        "metadata"
      ],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/contractVersion"
        },
        "recordId": {
          "$ref": "#/$defs/recordId"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": ["active", "archived", "trashed"]
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "createdBy": {
          "$ref": "#/$defs/actor"
        },
        "privacy": {
          "$ref": "#/$defs/privacy"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "assetRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assetReference"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "recordDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacy", "content", "provenance", "metadata"],
      "properties": {
        "privacy": {
          "$ref": "#/$defs/privacy"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "assetRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assetReference"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "assetId",
        "createdAt",
        "createdBy",
        "privacy",
        "mediaType",
        "byteLength",
        "contentHash",
        "provenance"
      ],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/contractVersion"
        },
        "assetId": {
          "$ref": "#/$defs/assetId"
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "createdBy": {
          "$ref": "#/$defs/actor"
        },
        "privacy": {
          "$ref": "#/$defs/privacy"
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:;.*)?$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        },
        "originalName": {
          "type": "string",
          "maxLength": 1024
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "assetDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacy", "mediaType", "byteLength", "contentHash", "provenance"],
      "properties": {
        "privacy": {
          "$ref": "#/$defs/privacy"
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:;.*)?$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        },
        "originalName": {
          "type": "string",
          "maxLength": 1024
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "assetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "dataBase64"],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "dataBase64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "approvedAt", "approvedBy", "evidenceRef"],
      "properties": {
        "kind": {
          "enum": ["user", "migration", "recovery"]
        },
        "approvedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "approvedBy": {
          "$ref": "#/$defs/actor"
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "mutationOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "record"],
          "properties": {
            "type": {
              "const": "record.create"
            },
            "record": {
              "$ref": "#/$defs/recordDraft"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "recordId", "baseRevision", "record"],
          "properties": {
            "type": {
              "const": "record.revise"
            },
            "recordId": {
              "$ref": "#/$defs/recordId"
            },
            "baseRevision": {
              "type": "integer",
              "minimum": 1
            },
            "record": {
              "$ref": "#/$defs/record"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "recordId", "baseRevision"],
          "properties": {
            "type": {
              "enum": ["record.archive", "record.restore", "record.trash"]
            },
            "recordId": {
              "$ref": "#/$defs/recordId"
            },
            "baseRevision": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "string",
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "recordId", "baseRevision", "asset", "payload"],
          "properties": {
            "type": {
              "const": "asset.attach"
            },
            "recordId": {
              "$ref": "#/$defs/recordId"
            },
            "baseRevision": {
              "type": "integer",
              "minimum": 1
            },
            "asset": {
              "$ref": "#/$defs/assetDraft"
            },
            "reference": {
              "$ref": "#/$defs/assetReferenceDraft"
            },
            "payload": {
              "$ref": "#/$defs/assetPayload"
            }
          }
        }
      ]
    },
    "approvedMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "mutationId",
        "requestedAt",
        "requestedBy",
        "idempotencyKey",
        "approval",
        "operation",
        "provenance"
      ],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/contractVersion"
        },
        "mutationId": {
          "$ref": "#/$defs/mutationId"
        },
        "requestedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "requestedBy": {
          "$ref": "#/$defs/actor"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 16,
          "maxLength": 256
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "operation": {
          "$ref": "#/$defs/mutationOperation"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "auditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "eventId",
        "sequence",
        "occurredAt",
        "actor",
        "action",
        "resource",
        "mutationId"
      ],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/contractVersion"
        },
        "eventId": {
          "$ref": "#/$defs/eventId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "occurredAt": {
          "$ref": "#/$defs/timestamp"
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "action": {
          "enum": [
            "record.created",
            "record.revised",
            "record.archived",
            "record.restored",
            "record.trashed",
            "asset.attached"
          ]
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recordId", "revision"],
          "properties": {
            "recordId": {
              "$ref": "#/$defs/recordId"
            },
            "assetId": {
              "$ref": "#/$defs/assetId"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "mutationId": {
          "$ref": "#/$defs/mutationId"
        },
        "previousEventHash": {
          "$ref": "#/$defs/sha256"
        },
        "eventHash": {
          "$ref": "#/$defs/sha256"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "searchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "revision", "state", "privacy", "score", "snippet", "matchedFields"],
      "properties": {
        "recordId": {
          "$ref": "#/$defs/recordId"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": ["active", "archived", "trashed"]
        },
        "privacy": {
          "$ref": "#/$defs/privacy"
        },
        "title": {
          "type": "string",
          "maxLength": 1024
        },
        "score": {
          "type": "number"
        },
        "snippet": {
          "type": "string",
          "maxLength": 4096
        },
        "matchedFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["title", "content", "metadata", "provenance", "asset"]
          }
        }
      }
    },
    "changeFeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "events", "nextCursor", "hasMore"],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/contractVersion"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/auditEvent"
          }
        },
        "nextCursor": {
          "$ref": "#/$defs/opaqueCursor"
        },
        "hasMore": {
          "type": "boolean"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "code", "message", "retryable"],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/contractVersion"
        },
        "code": {
          "enum": [
            "invalid_request",
            "unauthenticated",
            "unauthorized",
            "not_found",
            "conflict",
            "approval_required",
            "integrity_failed",
            "unsupported_version",
            "internal_error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
