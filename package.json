{
  "name": "personal-vault",
  "version": "0.1.0",
  "private": true,
  "description": "User-owned Markdown vault engine and MCP server.",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/personal-ai-systems/personal-vault.git"
  },
  "homepage": "https://github.com/personal-ai-systems/personal-vault#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./core": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.mjs"
    }
  },
  "files": [
    "lib/",
    "mcp/",
    "scripts/",
    "LICENSE",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "mcp:vault": "node mcp/personal-vault-server.mjs",
    "import:openai": "node scripts/import-openai-export.mjs",
    "test": "npm run test:lib && npm run test:mcp-smoke && npm run test:import-openai",
    "test:lib": "node scripts/lib-smoke-test.mjs",
    "test:mcp-smoke": "node scripts/mcp-smoke-test.mjs",
    "test:import-openai": "node scripts/openai-import-test.mjs",
    "test:context": "node scripts/context-smoke-test.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:secrets:history": "node scripts/scan-secrets.mjs --history"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fflate": "^0.8.3",
    "zod": "^4.4.3"
  }
}
